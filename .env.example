# PayGuard-AgentX environment configuration.
# Copy to .env (which is gitignored) and fill in. Never commit real secrets.

# --- Audit signing (HMAC-SHA256) ---
# Server-held secret used to sign evidence dossiers. Use a long random value in any real run.
PAYGUARD_AUDIT_KEY=change-me-to-a-long-random-secret
PAYGUARD_DEMO_MODE=true
PAYGUARD_DATABASE_URL=
PAYGUARD_SQLITE_PATH=.payguard/workspace.sqlite

# Optional published deployment OIDC settings
PAYGUARD_OIDC_CLIENT_ID=
PAYGUARD_OIDC_CLIENT_SECRET=
PAYGUARD_OIDC_DISCOVERY_URL=
PAYGUARD_OIDC_REDIRECT_URI=

# --- Live LLM (self-hosted only) ---
# Per the course constraint, only self-hosted runtimes are used (Ollama or vLLM);
# no cloud provider is ever called. Leave PAYGUARD_LLM_MODEL empty for the
# deterministic offline fallback.
PAYGUARD_LLM_BACKEND=offline   # offline | ollama | vllm
PAYGUARD_LLM_MODEL=
# ollama: PAYGUARD_LLM_BACKEND=ollama PAYGUARD_LLM_MODEL=phi4-mini
# vllm:   PAYGUARD_LLM_BACKEND=vllm   PAYGUARD_LLM_MODEL=<model served by vLLM>
OLLAMA_HOST=http://localhost:11434
VLLM_HOST=http://localhost:8000
