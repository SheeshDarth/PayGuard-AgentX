# PayGuard-AgentX environment configuration.
# Copy to .env (which is gitignored) and fill in. Never commit real secrets.

# --- Audit signing (HMAC-SHA256) ---
# Server-held secret used to sign evidence dossiers. Use a long random value in any real run.
PAYGUARD_AUDIT_KEY=change-me-to-a-long-random-secret

# --- Live LLM (optional) ---
# Leave PAYGUARD_LLM_MODEL empty to use the deterministic offline fallback.
# Set it (LiteLLM format) plus the matching provider key to enable real reasoning.
PAYGUARD_LLM_MODEL=
# e.g. PAYGUARD_LLM_MODEL=gemini/gemini-1.5-flash
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
